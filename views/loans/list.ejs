<%- include('../partials/header') %>

<h1>All Loans</h1>

<% if (loans.length === 0) { %>
  <p class="empty-state">No loans recorded yet.</p>
<% } else { %>
  <table class="data-table">
    <thead>
      <tr>
        <th>Book</th>
        <th>Member</th>
        <th>Borrowed</th>
        <th>Due</th>
        <th>Status</th>
        <th>Fine</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% loans.forEach(loan => { %>
        <tr class="<%= loan.isOverdue ? 'row-overdue' : '' %>">
          <td><%= loan.book_title %></td>
          <td><%= loan.member_name %> <span class="muted"><%= loan.member_email %></span></td>
          <td><%= new Date(loan.borrowed_at).toLocaleDateString() %></td>
          <td><%= new Date(loan.due_at).toLocaleDateString() %></td>
          <td>
            <% if (loan.status === 'returned') { %>
              <span class="status-pill">Returned</span>
            <% } else if (loan.isOverdue) { %>
              <span class="status-pill unavailable">Overdue</span>
            <% } else { %>
              <span class="status-pill info">Borrowed</span>
            <% } %>
          </td>
          <td><%= loan.currentFine > 0 ? '₦' + loan.currentFine : '—' %></td>
          <td>
            <% if (loan.status === 'borrowed') { %>
              <form action="/loans/<%= loan.id %>/return" method="POST">
                <button type="submit" class="btn-small">Mark Returned</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<%- include('../partials/footer') %>
